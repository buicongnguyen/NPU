{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buicongnguyen.github.io/NPU/schemas/analog-cim-evidence.schema.json",
  "title": "Analog CIM accuracy evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "studies", "issues", "claimTests"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "updated", "verdict", "reason"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "updated": { "type": "string", "format": "date" },
        "verdict": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "studies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "year", "title", "venue", "technology", "scope", "evidenceLevel", "reportedResult", "whatItShows", "whatItDoesNotShow", "verdict", "sourceUrl"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
          "title": { "$ref": "#/$defs/text" },
          "venue": { "$ref": "#/$defs/text" },
          "technology": { "$ref": "#/$defs/text" },
          "scope": { "$ref": "#/$defs/text" },
          "evidenceLevel": {
            "enum": ["measured", "partial", "conditional", "open", "vendor"]
          },
          "reportedResult": { "$ref": "#/$defs/text" },
          "whatItShows": { "$ref": "#/$defs/text" },
          "whatItDoesNotShow": { "$ref": "#/$defs/text" },
          "verdict": { "$ref": "#/$defs/text" },
          "sourceUrl": { "$ref": "#/$defs/httpsUrl" }
        }
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "symptom", "rootCause", "mitigations", "cost"],
        "properties": {
          "layer": { "$ref": "#/$defs/text" },
          "symptom": { "$ref": "#/$defs/text" },
          "rootCause": { "$ref": "#/$defs/text" },
          "mitigations": { "$ref": "#/$defs/text" },
          "cost": { "$ref": "#/$defs/text" }
        }
      }
    },
    "claimTests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "status", "answer", "limit", "sources"],
        "properties": {
          "question": { "$ref": "#/$defs/text" },
          "status": { "enum": ["answered", "conditional", "open"] },
          "answer": { "$ref": "#/$defs/text" },
          "limit": { "$ref": "#/$defs/text" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "url"],
              "properties": {
                "label": { "$ref": "#/$defs/text" },
                "url": { "$ref": "#/$defs/httpsUrl" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "text": { "type": "string", "minLength": 1 },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
  }
}

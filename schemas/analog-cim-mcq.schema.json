{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buicongnguyen.github.io/NPU/schemas/analog-cim-mcq.schema.json",
  "title": "Analog CIM multiple-choice questions",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "questions", "sources"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "updated", "questionCount", "answerIndexing", "choiceOrder", "license"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "updated": { "type": "string", "format": "date" },
        "questionCount": { "type": "integer", "minimum": 1 },
        "answerIndexing": { "$ref": "#/$defs/text" },
        "choiceOrder": { "$ref": "#/$defs/text" },
        "license": { "$ref": "#/$defs/text" }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topic", "difficulty", "prompt", "choices", "answer", "explanation", "sourceIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "topic": { "$ref": "#/$defs/text" },
          "difficulty": { "enum": ["Foundation", "Intermediate", "Advanced"] },
          "prompt": { "$ref": "#/$defs/text" },
          "choices": { "type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
          "answer": { "type": "integer", "minimum": 0 },
          "explanation": { "$ref": "#/$defs/text" },
          "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "$ref": "#/$defs/text" },
          "url": { "$ref": "#/$defs/httpsUrl" }
        }
      },
      "propertyNames": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "text": { "type": "string", "minLength": 1 },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
  }
}
